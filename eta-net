cleanup() {
    trap '' INT TERM
    if ((cleanup_done)); then
        return
    fi
    cleanup_done=1
    if ((!lock_held)); then
        return
    fi
    rm -f "$READY_FILE" "$HEALTH_FILE" "$STACK_FILE"
    if ((network_cleanup_owned)); then
        clear_packet_policy || true
    fi
    stop_nfq
    stop_tun
    stop_tether_proxy
    stop_transport
    if ((resolver_routes_installed)); then
        if resolver_rules del >/dev/null 2>&1; then
            resolver_routes_installed=0
        fi
    fi
    clear_direct_route || true
    if ((wake_lock_held)); then
        command -v termux-wake-unlock >/dev/null && termux-wake-unlock >/dev/null 2>&1 || true
    fi
    if ((lock_held)); then
        rm -f "$LOCK_DIR/pid"
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
}

acquire_lock() {
    local old_pid="" old_command=""
    mkdir -p "$STATE_DIR" || return 1
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        if [[ -r "$LOCK_DIR/pid" ]]; then
            old_pid=$(<"$LOCK_DIR/pid")
        fi
        if [[ "$old_pid" =~ ^[0-9]+$ && -d "/proc/$old_pid" ]]; then
            old_command=$(tr '\0' ' ' <"/proc/$old_pid/cmdline" 2>/dev/null || true)
            if [[ -z "$old_command" || "$old_command" == *eta-net* ]]; then
                printf 'eta-net is already running.\n' >&2
                return 1
            fi
        fi
        rm -f "$LOCK_DIR/pid"
        if ! rmdir "$LOCK_DIR" 2>/dev/null || ! mkdir "$LOCK_DIR" 2>/dev/null; then
            printf 'Unable to acquire eta-net lock.\n' >&2
            return 1
        fi
    fi
    printf '%s\n' "$$" >"$LOCK_DIR/pid"
    rm -f "$READY_FILE"
    lock_held=1
}

