tun_process_is_owned() {
    su -c "
        test -r '${TUN_PID_FILE}' || exit 1
        p=\$(cat '${TUN_PID_FILE}')
        case \"\$p\" in *[!0-9]*|'') exit 1 ;; esac
        test -e /proc/\$p/exe || exit 1
        test \"\$(readlink /proc/\$p/exe)\" = '${TUN_BIN}'
    " >/dev/null 2>&1
}

tun_pid_is_owned() {
    local eta_tun_pid=$1
    [[ "$eta_tun_pid" =~ ^[0-9]+$ ]] || return 1
    su -c "test -e /proc/${eta_tun_pid}/exe && test \"\$(readlink /proc/${eta_tun_pid}/exe)\" = '${TUN_BIN}'" \
        >/dev/null 2>&1
}

terminate_tun_pid() {
    local attempt eta_tun_pid=$1
    tun_pid_is_owned "$eta_tun_pid" || return 1
    su -c "kill -INT ${eta_tun_pid}" >/dev/null 2>&1 || true
    for ((attempt = 0; attempt < 50; attempt++)); do
        tun_pid_is_owned "$eta_tun_pid" || return 0
        sleep 0.1
    done
    su -c "kill -KILL ${eta_tun_pid}" >/dev/null 2>&1 || true
    for ((attempt = 0; attempt < 20; attempt++)); do
        tun_pid_is_owned "$eta_tun_pid" || return 0
        sleep 0.1
    done
    return 1
}

reap_stale_tun() {
    local attempt eta_tun_pid=""
    [[ -d /sys/class/net/eta0 ]] || return 0
    eta_tun_pid=$(su -c "cat '${TUN_PID_FILE}' 2>/dev/null" | tr -d '\r\n')
    if ! terminate_tun_pid "$eta_tun_pid"; then
        printf 'eta0 exists without a reclaimable eta-tun2socks owner.\n' >&2
        return 1
    fi
    su -c "rm -f '${TUN_PID_FILE}'" >/dev/null 2>&1 || return 1
    for ((attempt = 0; attempt < 30; attempt++)); do
        [[ ! -d /sys/class/net/eta0 ]] && return 0
        sleep 0.1
    done
    [[ ! -d /sys/class/net/eta0 ]]
}

nfq_pid_is_owned() {
    local eta_nfq_pid=$1
