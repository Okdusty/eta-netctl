    su -c "awk -v q='${NFQ_QUEUE}' -v p='${eta_nfq_pid}' '\$1 == q && \$2 == p { found=1 } END { exit !found }' /proc/net/netfilter/nfnetlink_queue" \
        >/dev/null 2>&1
}

nfq_process_is_owned() {
    local eta_nfq_pid=""
    eta_nfq_pid=$(su -c "cat '${NFQ_PID_FILE}' 2>/dev/null" | tr -d '\r\n')
    nfq_pid_is_owned "$eta_nfq_pid" && nfq_queue_is_bound "$eta_nfq_pid"
