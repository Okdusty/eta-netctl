start_nfq() {
    local attempt nfq_command rule_index
    local -a command_args
    reap_stale_nfq || return 1
    command_args=("$NFQ_BIN" "--qnum=${NFQ_QUEUE}" "--uid=1:3003" --debug=0)
    for ((rule_index = 0; rule_index < ${#FAKE_RULE_TYPES[@]}; rule_index++)); do
        command_args+=(--filter-tcp=443 --filter-l7=tls)
        if [[ "${FAKE_RULE_TYPES[$rule_index]}" == domain ]]; then
            command_args+=("--hostlist-domains=${FAKE_RULE_TARGETS[$rule_index]}")
        else
            command_args+=("--ipset-ip=${FAKE_RULE_TARGETS[$rule_index]}")
        fi
        command_args+=(
            --dpi-desync=fake
            "--dpi-desync-ttl=${DIRECT_FAKE_TTL}"
            "--dpi-desync-fwmark=${NFQ_BYPASS_MARK}"
            "--dpi-desync-fake-tls-mod=rnd,sni=${FAKE_RULE_DECOYS[$rule_index]},dupsid"
            --new
        )
    done
    command_args+=(
        --filter-tcp=443 --filter-l7=tls
        --dpi-desync=fake
        "--dpi-desync-ttl=${DIRECT_FAKE_TTL}"
        "--dpi-desync-fwmark=${NFQ_BYPASS_MARK}"
            "--dpi-desync-fake-tls-mod=rnd,sni=${ACTIVE_FAKE_SNI},dupsid"
    )
    printf -v nfq_command '%q ' "${command_args[@]}"
    su -c "rm -f '${NFQ_PID_FILE}'; echo \$\$ > '${NFQ_PID_FILE}'; exec ${nfq_command}" &
    nfq_launcher_pid=$!
    nfq_started=1
    for ((attempt = 0; attempt < 50; attempt++)); do
        nfq_pid=$(su -c "cat '${NFQ_PID_FILE}' 2>/dev/null" | tr -d '\r\n')
        if nfq_pid_is_owned "$nfq_pid" && nfq_queue_is_bound "$nfq_pid"; then
            return 0
        fi
        child_is_live "$nfq_launcher_pid" || break
        sleep 0.1
    done
    stop_nfq
    return 1
}

stop_nfq() {
    local attempt eta_nfq_pid=""
