    fi
    direct_stack=tun
    printf 'TUN profile: %s.\n' "${TUN_CONFIG##*/}"
    if ! start_tun_stack; then
        printf 'eta0 did not become ready.\n' >&2
        exit 1
    fi
fi

if ((TETHER_MODE)); then
    if [[ "$transport_kind" == direct ]]; then
        if ! start_tether_proxy; then
            printf 'Hotspot/USB transparent listener did not start.\n' >&2
            exit 1
        fi
        printf 'Tether bridge: HTTPS, DoT, and DNS on hotspot/USB.\n'
    else
        printf 'Tether bridge requires direct transport; hotspot/USB left unchanged.\n' >&2
    fi
fi

if ! install_packet_policy; then
    printf 'Unable to install application TCP routing.\n' >&2
    exit 1
fi

if [[ "$transport_kind" == direct ]] && ! flush_android_dns_cache; then
    printf 'Warning: Android DNS cache flush failed; stale answers expire normally.\n' >&2
fi

if ! restart_target_apps; then
    printf 'Warning: target app restart failed; reopen it manually.\n' >&2
fi

watchdog_available=0
if resolve_watchdog_uid; then
    watchdog_available=1
elif ((WATCHDOG_INTERVAL > 0)); then
    printf 'Warning: Termux UID unavailable; app-path watchdog disabled.\n' >&2
    WATCHDOG_INTERVAL=0
fi

if ((watchdog_available)) && ! watchdog_check; then
    if [[ "$transport_kind" == direct && "$direct_stack" == nfqueue && "$DIRECT_STACK" == auto ]] && ((tun_available)); then
        printf 'Initial NFQUEUE check failed; switching to TUN fallback.\n' >&2
        mark_nfq_cooldown || true
        clear_packet_policy || exit 1
        stop_nfq || exit 1
        direct_stack=tun
        printf 'TUN profile: %s.\n' "${TUN_CONFIG##*/}"
        start_tun_stack || exit 1
        install_packet_policy || exit 1
        if ! watchdog_check; then
            printf 'Initial TUN fallback check failed.\n' >&2
            exit 1
        fi
    else
        printf 'Initial app-path health check failed.\n' >&2
        exit 1
    fi
fi

if [[ "$transport_kind" == direct && "$direct_stack" == nfqueue ]]; then
    if switch_direct_dns_to_nfq; then
        printf 'DNS path: direct DoH through NFQUEUE; local SOCKS layer stopped.\n'
        if ((watchdog_available)) && ! watchdog_check; then
            printf 'Direct DoH validation failed; restoring SOCKS DNS fallback.\n' >&2
            start_direct_transport || exit 1
            watchdog_check || exit 1
        fi
    else
        printf 'Direct DoH did not become ready; keeping SOCKS DNS fallback.\n' >&2
    fi
fi

if ! publish_health; then
    printf 'Unable to publish app-path liveness.\n' >&2
    exit 1
fi

stack_tmp="${STACK_FILE}.tmp.$$"
ready_tmp="${READY_FILE}.tmp.$$"
if ! printf '%s\n' "$direct_stack" >"$stack_tmp" || ! mv -f "$stack_tmp" "$STACK_FILE" || \
   ! printf '%s\n' "$$" >"$ready_tmp" || ! mv -f "$ready_tmp" "$READY_FILE"; then
    rm -f "$stack_tmp" "$ready_tmp"
    printf 'Unable to publish eta-net readiness.\n' >&2
    exit 1
fi

if [[ "$ROUTE_ALL_APPS" == 1 ]]; then
    printf 'All application TCP uses the %s data stack.\n' "$direct_stack"
else
    printf 'Target application TCP uses the %s data stack.\n' "$direct_stack"
fi
if [[ "$ROUTE_SYSTEM_DNS" == 1 && "$transport_kind" == direct ]]; then
    printf 'Android DNS uses local DoH. QUIC falls back to TCP; other UDP stays direct.\n'
elif [[ "$ROUTE_SYSTEM_DNS" == 1 ]]; then
    printf 'Android DNS uses the server. QUIC falls back to TCP; other UDP stays direct.\n'
else
    printf 'Target raw DNS uses the server; Android system DNS stays direct. QUIC falls back to TCP; other UDP stays direct.\n'
fi
printf 'Keep Termux open; Ctrl+C stops.\n'

watchdog_elapsed=0
watchdog_failure_count=0
while { [[ -z "$transport_pid" ]] || child_is_live "$transport_pid"; } && \
      { [[ -z "$dns_proxy_pid" ]] || child_is_live "$dns_proxy_pid"; } && \
      data_stack_is_live; do
    sleep 5
    if ((WATCHDOG_INTERVAL > 0)); then
        ((watchdog_elapsed += 5))
        if ((watchdog_elapsed >= WATCHDOG_INTERVAL)); then
            watchdog_elapsed=0
            if watchdog_check; then
                watchdog_failure_count=0
                publish_health || {
                    printf 'Unable to update app-path health.\n' >&2
                    exit 1
                }
            else
                ((watchdog_failure_count++))
                printf 'App-path watchdog failure %s/%s.\n' \
                    "$watchdog_failure_count" "$WATCHDOG_FAILURES" >&2
                if ((watchdog_failure_count >= WATCHDOG_FAILURES)); then
                    if [[ "$direct_stack" == nfqueue && "$DIRECT_STACK" == auto ]]; then
                        mark_nfq_cooldown || true
                        printf 'NFQUEUE cooldown requested; next start uses TUN fallback.\n' >&2
                    fi
                    printf 'App-path watchdog requested restart.\n' >&2
                    exit 1
                fi
            fi
        fi
    fi
done
if [[ "$direct_stack" == nfqueue && "$DIRECT_STACK" == auto ]]; then
    mark_nfq_cooldown || true
    printf 'NFQUEUE component stopped; next start uses TUN fallback.\n' >&2
fi
printf 'An eta-net component stopped.\n' >&2
exit 1
