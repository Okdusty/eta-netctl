start_dns_transport() {
    local mode=$1 attempt service_name=socks-fast edns_size=1232
    local -a command_args
    [[ -n "$DNS_SUFFIX" ]] || {
        printf 'ETA_DNS_SUFFIX is required for DNS transport.\n' >&2
        return 1
    }
    stop_transport
    if ((RESPONSE_SIZE != 957)); then
        service_name="socks-fast:${RESPONSE_SIZE}"
    fi
    if ((RESPONSE_SIZE > edns_size)); then
        edns_size=$RESPONSE_SIZE
    fi
    command_args=(
        client
        -remote "$remote_list"
        -listen "127.0.0.1:${SOCKS_PORT}"
        -key-file "$DNSSTREAM_KEY"
        -suffix "$DNS_SUFFIX"
        -service "$service_name"
        -edns-size "$edns_size"
        -upstream-window "$UPSTREAM_WINDOW"
        -downstream-window "$DOWNSTREAM_WINDOW"
    )
    if [[ "$mode" == udp ]]; then
        if ((UPSTREAM_WINDOW > 1 || DOWNSTREAM_WINDOW > 1)); then
            command_args+=(-transactions-per-udp 1)
        else
            command_args+=(-transactions-per-udp 2)
        fi
        command_args+=(-udp-inflight "$UDP_INFLIGHT")
    elif [[ "$mode" == tcp ]]; then
        command_args+=(-tcp -transactions-per-tcp 32 -tcp-pool-size "$TCP_POOL_SIZE")
    else
        return 1
    fi
    "$DNSSTREAM" "${command_args[@]}" &
    transport_pid=$!
    transport_kind=dns
    transport_mode=$mode
    for ((attempt = 0; attempt < 40; attempt++)); do
        if ! child_is_live "$transport_pid"; then
            break
        fi
        transport_listener_ready && return 0
        sleep 0.05
    done
    if ! child_is_live "$transport_pid" || ! transport_listener_ready; then
        stop_transport
        return 1
    fi
}

start_tls_transport() {
    local attempt
    stop_transport
    "$TLS_GATEWAY" tls-client \
        -remote "$TLS_REMOTE" \
        -listen "127.0.0.1:${SOCKS_PORT}" \
        -sni "$TLS_SNI" \
        -cert "$TLS_CERT_DIR/client.crt" \
        -key "$TLS_CERT_DIR/client.key" \
        -ca "$TLS_CERT_DIR/ca.crt" \
        -mux-carriers "$TLS_CARRIERS" \
        -tcp-buffer "$TLS_TCP_BUFFER" &
    transport_pid=$!
    transport_kind=tls
    transport_mode=tls
    for ((attempt = 0; attempt < 40; attempt++)); do
        if ! child_is_live "$transport_pid"; then
            break
        fi
        transport_listener_ready && return 0
        sleep 0.05
    done
    if ! child_is_live "$transport_pid" || ! transport_listener_ready; then
        stop_transport
        return 1
    fi
}

start_direct_dns() {
    local mode=$1 attempt listen_spec="127.0.0.1:${DIRECT_DNS_PORT},[::1]:${DIRECT_DNS_PORT}"
    local -a command_args
    stop_dns_proxy
    if ((TETHER_MODE)); then
        listen_spec="0.0.0.0:${DIRECT_DNS_PORT}"
    fi
    command_args=(
        -listen "$listen_spec"
        -endpoint "$DIRECT_DOH_ENDPOINT"
        -bootstrap "$DIRECT_DOH_BOOTSTRAP"
        -timeout "${DIRECT_DOH_TIMEOUT}s"
        -attempt-timeout "$DIRECT_DOH_ATTEMPT_TIMEOUT"
        -fallback-resolvers "$DIRECT_DNS_FALLBACK"
        -fallback-timeout "$DIRECT_DNS_FALLBACK_TIMEOUT"
    )
    if [[ "$mode" == nfqueue ]]; then
        command_args+=(-socks direct -fwmark "$NFQ_ROUTE_MARK")
    elif [[ "$mode" == socks ]]; then
        command_args+=(-socks "127.0.0.1:${SOCKS_PORT}")
    else
        return 1
    fi
    "$DIRECT_DNS" "${command_args[@]}" &
    dns_proxy_pid=$!
    for ((attempt = 0; attempt < 40; attempt++)); do
        if ! child_is_live "$dns_proxy_pid"; then
            break
        fi
        listener_ready "$DIRECT_DNS_PORT" && return 0
        sleep 0.05
    done
    stop_dns_proxy
    return 1
}

start_direct_transport() {
    local attempt rule_index target_text
    local -a command_args
    stop_transport
    command_args=(
        -i 127.0.0.1
        -p "$SOCKS_PORT"
        -b "$DIRECT_BUFFER"
        -c "$DIRECT_MAX_CONNECTIONS"
        -x 0
        -I 0.0.0.0
        -k "$DIRECT_ROUTE_MARK"
        -N
        -U
        -X
    )
    for ((rule_index = 0; rule_index < ${#FAKE_RULE_TYPES[@]}; rule_index++)); do
        target_text=${FAKE_RULE_TARGETS[$rule_index]//,/ }
        if [[ "${FAKE_RULE_TYPES[$rule_index]}" == domain ]]; then
            command_args+=(-H ":${target_text}")
        else
            command_args+=(-j ":${target_text}")
        fi
        command_args+=(
            -f"$DIRECT_FAKE_POSITION" -t"$DIRECT_FAKE_TTL"
            -n "${FAKE_RULE_DECOYS[$rule_index]}" -Qr -A n
        )
    done
    command_args+=(-f"$DIRECT_FAKE_POSITION" -t"$DIRECT_FAKE_TTL")
    for target_text in "${FAKE_SNI_POOL[@]}"; do
        command_args+=(-n "$target_text")
    done
    command_args+=(-Qr)
    if ((${#DIRECT_EXTRA_ARGS[@]})); then
        command_args+=("${DIRECT_EXTRA_ARGS[@]}")
    fi
    "$DIRECT_GATEWAY" "${command_args[@]}" &
    transport_pid=$!
    transport_kind=direct
    transport_mode=direct
    for ((attempt = 0; attempt < 40; attempt++)); do
        if ! child_is_live "$transport_pid"; then
            break
        fi
        transport_listener_ready && break
        sleep 0.05
    done
    if ! child_is_live "$transport_pid" || ! transport_listener_ready; then
        stop_transport
        return 1
    fi

    if start_direct_dns socks; then
        return 0
    fi
    stop_transport
    return 1
}

carrier_check() {
    local reddit_code
    reddit_code=$(env -u ALL_PROXY -u HTTPS_PROXY -u HTTP_PROXY -u NO_PROXY \
        -u all_proxy -u https_proxy -u http_proxy -u no_proxy \
        "$TERMUX_PREFIX/bin/curl" --socks5-hostname "127.0.0.1:${SOCKS_PORT}" \
        --noproxy '' \
        -A 'Mozilla/5.0 (Android 14) eta-net' \
        -sS -I --connect-timeout "$HEALTH_TIMEOUT" --max-time "$HEALTH_TIMEOUT" \
        -o /dev/null -w '%{http_code}' \
        https://old.reddit.com/ 2>/dev/null || true)
    [[ "$reddit_code" =~ ^[1-5][0-9][0-9]$ ]]
}

direct_carrier_check() {
    local check_ip check_code
    check_ip=$("$TERMUX_PREFIX/bin/dig" \
        @127.0.0.1 -p "$DIRECT_DNS_PORT" "$DIRECT_CHECK_HOST" A \
        +short +time="$HEALTH_TIMEOUT" +tries=1 2>/dev/null | \
        "$TERMUX_PREFIX/bin/awk" '/^([0-9]{1,3}\.){3}[0-9]{1,3}$/ { print; exit }')
    [[ "$check_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    check_code=$(env -u ALL_PROXY -u HTTPS_PROXY -u HTTP_PROXY -u NO_PROXY \
        -u all_proxy -u https_proxy -u http_proxy -u no_proxy \
        "$TERMUX_PREFIX/bin/curl" --socks5 "127.0.0.1:${SOCKS_PORT}" \
        --resolve "${DIRECT_CHECK_HOST}:443:${check_ip}" \
        --noproxy '' \
        -A 'Mozilla/5.0 (Android 14) eta-net' \
        -sS --connect-timeout "$HEALTH_TIMEOUT" --max-time "$HEALTH_TIMEOUT" \
        -o /dev/null -w '%{http_code}' \
        "$DIRECT_CHECK_URL" 2>/dev/null || true)
    [[ "$check_code" =~ ^[1-5][0-9][0-9]$ ]]
}

direct_dns_check() {
    local check_ip
    check_ip=$("$TERMUX_PREFIX/bin/dig" \
        @127.0.0.1 -p "$DIRECT_DNS_PORT" discord.com A \
        +short +time=3 +tries=1 2>/dev/null | \
        "$TERMUX_PREFIX/bin/awk" '/^([0-9]{1,3}\.){3}[0-9]{1,3}$/ { print; exit }')
    [[ "$check_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$check_ip" != 195.175.254.2 ]]
}

switch_direct_dns_to_nfq() {
    if ! start_direct_dns nfqueue; then
        start_direct_dns socks || return 1
        return 1
    fi
    if ! direct_dns_check; then
        start_direct_dns socks || return 1
        return 1
    fi
    stop_primary_transport
    return 0
}

resolve_watchdog_uid() {
    local android_user package_line watchdog_package
    if [[ "$ROUTE_ALL_APPS" == 1 ]]; then
        android_user=0
        watchdog_package=com.termux
    else
        android_user=$(current_android_user) || return 1
        watchdog_package=${TARGET_PACKAGES[0]:-}
    fi
    [[ "$watchdog_package" =~ ^[A-Za-z0-9._]+$ ]] || return 1
    package_line=$(su -c "${ANDROID_BIN}/cmd package list packages -U --user ${android_user} ${watchdog_package}" 2>/dev/null | \
        "$TERMUX_PREFIX/bin/awk" -v wanted="package:${watchdog_package}" '$1 == wanted { print; exit }')
    watchdog_uid=${package_line##*uid:}
    [[ "$watchdog_uid" =~ ^[0-9]+$ ]] && ((watchdog_uid >= 10000))
}

watchdog_check() {
    local watchdog_code
    watchdog_code=$(su "$watchdog_uid" -c \
        "'$TERMUX_PREFIX/bin/curl' --noproxy '*' -4 -sS --connect-timeout '$WATCHDOG_TIMEOUT' --max-time '$WATCHDOG_TIMEOUT' -o /dev/null -w '%{http_code}' https://www.google.com/generate_204" \
        2>/dev/null | tr -d '\r\n' || true)
    [[ "$watchdog_code" == 204 ]]
}

