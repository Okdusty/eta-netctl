    [[ "$android_user" =~ ^[0-9]+$ ]] || return 1
    for package in "${TARGET_PACKAGES[@]}"; do
        [[ "$package" =~ ^[A-Za-z0-9._]+$ ]] || return 1
        launcher=$(su -c "${ANDROID_BIN}/cmd package resolve-activity --brief --user ${android_user} -c android.intent.category.LAUNCHER ${package}" 2>/dev/null | "$TERMUX_PREFIX/bin/awk" '/\// { value=$0 } END { print value }')
        [[ "$launcher" =~ ^[A-Za-z0-9._]+/[A-Za-z0-9._$]+$ ]] || return 1
