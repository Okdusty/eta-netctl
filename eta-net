valid_resolver() {
    local value=$1 address port octet
    local -a octets
    [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]{1,5}$ ]] || return 1
    address=${value%:*}
    port=${value##*:}
    ((10#$port >= 1 && 10#$port <= 65535)) || return 1
    IFS=. read -r -a octets <<< "$address"
    for octet in "${octets[@]}"; do
        ((10#$octet <= 255)) || return 1
    done
}

valid_domain_name() {
    local value=$1 label
    local -a labels
    [[ ${#value} -ge 1 && ${#value} -le 253 && "$value" =~ ^[A-Za-z0-9.-]+$ && "$value" != *".."* ]] || return 1
    IFS=. read -r -a labels <<< "$value"
    for label in "${labels[@]}"; do
        [[ ${#label} -ge 1 && ${#label} -le 63 && "$label" != -* && "$label" != *- ]] || return 1
    done
}

valid_ipv4_selector() {
    local value=$1 address=$1 prefix=32 octet
    local -a octets
    if [[ "$value" == */* ]]; then
        address=${value%/*}
        prefix=${value##*/}
    fi
    [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$prefix" =~ ^[0-9]+$ ]] || return 1
    ((10#$prefix >= 1 && 10#$prefix <= 32)) || return 1
    IFS=. read -r -a octets <<< "$address"
    for octet in "${octets[@]}"; do
        ((10#$octet <= 255)) || return 1
    done
}

normalize_fake_sni_pool() {
    local candidate existing duplicate
    local -a candidates
    FAKE_SNI_POOL=()
    IFS=, read -r -a candidates <<< "$fake_sni_pool_spec"
    ((${#candidates[@]} >= 1 && ${#candidates[@]} <= 8)) || {
        printf 'The fake SNI pool must contain 1 to 8 names.\n' >&2
        return 1
    }
    for candidate in "${candidates[@]}"; do
        valid_domain_name "$candidate" || {
            printf 'Invalid fake SNI pool name: %s\n' "$candidate" >&2
            return 1
        }
        duplicate=0
        for existing in "${FAKE_SNI_POOL[@]}"; do
            if [[ "$existing" == "$candidate" ]]; then
                duplicate=1
                break
            fi
        done
        ((duplicate)) || FAKE_SNI_POOL+=("$candidate")
    done
    DIRECT_FAKE_SNI=${FAKE_SNI_POOL[0]}
    ACTIVE_FAKE_SNI=${FAKE_SNI_POOL[RANDOM % ${#FAKE_SNI_POOL[@]}]}
}

normalize_fake_sni_rules() {
    local spec selectors decoy selector rule_type selector_type normalized
    local -a selector_values
    FAKE_RULE_TYPES=()
    FAKE_RULE_TARGETS=()
    FAKE_RULE_DECOYS=()
    ((${#FAKE_SNI_RULE_SPECS[@]} <= 16)) || {
        printf 'At most 16 --fake-sni-rule profiles are supported.\n' >&2
        return 1
    }
    for spec in "${FAKE_SNI_RULE_SPECS[@]}"; do
        [[ "$spec" == *=* && "$spec" != =* && "$spec" != *= ]] || {
            printf 'Invalid fake SNI rule: %s\n' "$spec" >&2
            return 1
        }
        selectors=${spec%%=*}
        decoy=${spec#*=}
        valid_domain_name "$decoy" || {
            printf 'Invalid fake SNI rule decoy: %s\n' "$decoy" >&2
            return 1
        }
        IFS=, read -r -a selector_values <<< "$selectors"
        ((${#selector_values[@]} > 0)) || return 1
        rule_type=""
        normalized=""
        for selector in "${selector_values[@]}"; do
            if valid_ipv4_selector "$selector"; then
                selector_type=ip
            elif valid_domain_name "$selector"; then
                selector_type=domain
            else
                printf 'Invalid fake SNI rule target: %s\n' "$selector" >&2
                return 1
            fi
            if [[ -n "$rule_type" && "$selector_type" != "$rule_type" ]]; then
                printf 'Do not mix domain and IP targets in one fake SNI rule: %s\n' "$spec" >&2
                return 1
            fi
            rule_type=$selector_type
            normalized+="${selector},"
        done
        FAKE_RULE_TYPES+=("$rule_type")
        FAKE_RULE_TARGETS+=("${normalized%,}")
        FAKE_RULE_DECOYS+=("$decoy")
    done
}

normalize_inputs() {
    local value
    local -a carrier=() direct=() packages=()
    declare -A carrier_seen=() direct_seen=() package_seen=()
    for value in "${RESOLVERS[@]}"; do
        valid_resolver "$value" || { printf 'Invalid resolver: %s\n' "$value" >&2; return 1; }
        [[ -n "${carrier_seen[$value]:-}" ]] && continue
        carrier_seen[$value]=1
        carrier+=("$value")
    done
    ((${#carrier[@]} > 0)) || { printf 'At least one carrier resolver is required.\n' >&2; return 1; }
    for value in "${carrier[@]}" "${DIRECT_RESOLVERS[@]}" "${DIRECT_FALLBACK_RESOLVERS[@]}"; do
        valid_resolver "$value" || { printf 'Invalid direct resolver: %s\n' "$value" >&2; return 1; }
        [[ -n "${direct_seen[$value]:-}" ]] && continue
        direct_seen[$value]=1
        direct+=("$value")
    done
    ((${#direct[@]} <= TUN_RULE_PREF - RESOLVER_RULE_PREF)) || {
        printf 'At most %s direct resolvers are supported.\n' "$((TUN_RULE_PREF - RESOLVER_RULE_PREF))" >&2
        return 1
    }
    for value in "${TARGET_PACKAGES[@]}"; do
        [[ -n "${package_seen[$value]:-}" ]] && continue
        package_seen[$value]=1
        packages+=("$value")
    done
    RESOLVERS=("${carrier[@]}")
    DIRECT_RESOLVERS=("${direct[@]}")
    TARGET_PACKAGES=("${packages[@]}")
}

